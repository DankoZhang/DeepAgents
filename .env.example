# 模型提供商：openai | anthropic | openai_compatible
MODEL_PROVIDER=openai_compatible
MODEL_NAME=deepseek-chat

OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.deepseek.com/v1

# Anthropic（可选）
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# 工作区与安全
WORKSPACE_DIR=./workspace
ENABLE_HITL=false
LOG_LEVEL=INFO

# PostgreSQL（方法论 / Agent / Tool 配置库）
DATABASE_URL=postgresql+psycopg://deepagents:deepagents@localhost:5432/deepagents

# Redis checkpointer（需 Redis 8+ 或 Redis Stack）
REDIS_URL=redis://localhost:6379
# 生产建议 true：Redis 不可用时直接失败，避免静默回退内存导致会话串话/丢失
REQUIRE_REDIS_CHECKPOINTER=false

# FastAPI
API_HOST=0.0.0.0
API_PORT=8001

# 鉴权：外部 API 解析 Bearer token → user_id
# AUTH_DISABLED=true 时跳过外部调用，固定使用 AUTH_DEV_USER_ID（仅本地/测试）
AUTH_DISABLED=false
AUTH_DEV_USER_ID=dev-user
AUTH_INTROSPECT_URL=https://your-auth.example.com/oauth/introspect
# GET：请求头带 Authorization；POST：另发 JSON {"token":"..."}
AUTH_INTROSPECT_METHOD=GET
AUTH_USER_ID_FIELD=user_id
AUTH_TIMEOUT_SECONDS=5
AUTH_CACHE_TTL_SECONDS=60
