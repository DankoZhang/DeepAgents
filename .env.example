# 复制为 .env 后填入真实密钥
# cp .env.example .env

# 模型提供商：openai | anthropic | openai_compatible
MODEL_PROVIDER=openai

# 模型名称（openai 示例：gpt-4o；anthropic 示例：claude-sonnet-4-6）
MODEL_NAME=gpt-4o

# OpenAI
OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# 兼容 OpenAI API 的第三方（如 DeepSeek、通义、本地 vLLM）
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# MODEL_NAME=deepseek-chat

# 工作区与安全
WORKSPACE_DIR=./workspace
ENABLE_HITL=false
LOG_LEVEL=INFO
