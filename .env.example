# =============================================================================
# DeepAgents 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# =============================================================================

# ── 默认模型（主要用于 bootstrap 种子；已灌库后改这里不会自动改库内模型行）──
# 提供商：openai | anthropic | openai_compatible（DeepSeek 等兼容端点用后者）
MODEL_PROVIDER=openai_compatible
# 默认模型名（写入种子默认模型 / 组装时无目录模型时的回退）
MODEL_NAME=deepseek-chat
# OpenAI / 兼容接口的 API Key（openai、openai_compatible 使用）
OPENAI_API_KEY=sk-your-key
# OpenAI 兼容接口的 base URL；DeepSeek 带或不带 /v1 通常均可
OPENAI_BASE_URL=https://api.deepseek.com/v1
# Anthropic API Key（仅 MODEL_PROVIDER=anthropic 时需要）
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── 工作区与运行行为 ──────────────────────────────────────────────────
# Agent 可读写沙箱根目录（FilesystemBackend）；按用户隔离在其下 users/<scope>/
WORKSPACE_DIR=./workspace
# 默认 Memory 文件（相对项目根）；方法论 Memory 另有版本化物化，不单靠此文件
MEMORY_FILE=./AGENTS.md
# 是否启用 HITL：危险工具执行前暂停等人批准；工具也可单独 requires_hitl
ENABLE_HITL=true
# 应用日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── 基础设施 ──────────────────────────────────────────────────────────
# PostgreSQL 连接串（方法论 / Agent / Tool / Skill / 会话等配置库）
DATABASE_URL=postgresql+psycopg://deepagents:deepagents@127.0.0.1:5432/deepagents
# Redis（checkpoint / 缓存失效 pub/sub / SSE 全局限流 / GC 锁）
# 需 Redis 8+ 或 Redis Stack；不可用时直接失败，无内存降级
# Windows 建议 127.0.0.1：localhost 常解析到 ::1，而 compose 只映射 IPv4
REDIS_URL=redis://127.0.0.1:6379

# ── Agent 缓存与方法论快照 ────────────────────────────────────────────
# 进程内已编译 Agent 的 LRU 上限；淘汰时清构建锁（Skills 物化目录按内容寻址保留）
AGENT_CACHE_MAX_SIZE=32
# 每个方法论最多保留的历史快照条数；仍被会话引用或等于 live 版本的不会删
METHODOLOGY_REVISION_KEEP=20

# ── 运行时 GC（Skills 磁盘物化 + 孤儿 content_blob）────────────────────
# Skills 物化：.complete 超过该天数未刷新（touch）则删；0=禁用按天龄清理
SKILLS_GC_MAX_AGE_DAYS=14
# Skills 物化：残留临时目录超过该小时数则删
SKILLS_GC_TMP_MAX_AGE_HOURS=1
# Skills GC 后台调度间隔（小时）；0=后台不跑 Skills（仍可 CLI 手动）
# 手动：python -m deepagents_app.services.infra.gc [skills|blobs|all]
# 与 blob 共用一个 PeriodicTask；各用 Redis 锁，全集群同窗口只跑一次
SKILLS_GC_INTERVAL_HOURS=24
# 上传技能包 zip：压缩体积 / 解压体积 / 文件数 / 路径深度
SKILL_PACKAGE_MAX_BYTES=8388608
SKILL_PACKAGE_MAX_UNCOMPRESSED_BYTES=33554432
SKILL_PACKAGE_MAX_FILES=80
SKILL_PACKAGE_MAX_DEPTH=4
SKILL_PACKAGE_ALLOWED_SUFFIXES=.md,.py,.sh,.json,.yaml,.yml,.txt,.toml,.csv
# content_blob 孤儿 GC 间隔（小时）：删未被任何 revision 快照引用的正文；0=后台不跑
CONTENT_BLOB_GC_INTERVAL_HOURS=24

# ── 模型 api_key 入库加密 ─────────────────────────────────────────────
# 主密钥：Fernet url-safe base64，或任意口令（会 SHA256 派生）；生产必须设置
# 生成示例：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=
# true：未配置主密钥时允许固定开发密钥；与 AUTH_DISABLED 无关；生产必须 false
SECRETS_ALLOW_INSECURE_DEV_KEY=true
# 密钥轮转：旧主密钥逗号分隔；解密时主密钥失败后依次尝试；新写入只用主密钥
# SECRETS_ENCRYPTION_PREVIOUS_KEYS=

# ── MCP 安全 ──────────────────────────────────────────────────────────
# 是否允许 MCP stdio（会在 API 进程内拉起子进程）；默认关，本地调试再开
MCP_STDIO_ENABLED=false
# 允许的 stdio 可执行文件 basename（逗号分隔）；启用 stdio 时生效
MCP_STDIO_COMMAND_ALLOWLIST=npx,uvx,node,python,python3

# ── FastAPI 进程 ──────────────────────────────────────────────────────
# 监听地址（0.0.0.0 表示所有网卡）
API_HOST=0.0.0.0
# 监听端口（默认文档 /docs、探活 /health）
API_PORT=8001
# 进程数：1=单进程；>1 时缓存失效走 Redis pub/sub，流式限流在 auto 下走 Redis
API_WORKERS=2
# 启动器：uvicorn | gunicorn（后者用 UvicornWorker；Windows 无 fcntl 会回退 uvicorn）
API_SERVER=gunicorn
# 允许的前端 CORS 源（逗号分隔）；勿用 *（与 credentials 冲突）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 聊天流式限流与消息校验 ────────────────────────────────────────────
# 同时进行的 SSE 流式对话上限；0=不限制；抢不到槽返回 429
CHAT_STREAM_MAX_CONCURRENT=32
# 抢流式并发槽最多等待秒数；超时即失败；0≈立即 429、几乎不排队
CHAT_STREAM_ACQUIRE_TIMEOUT_SECONDS=1
# 限流作用域：auto=多 worker 用 Redis 全局，否则本进程；可强制 local / redis
CHAT_STREAM_LIMITER=auto
# 单条用户消息最大字符数；超限拒绝
CHAT_MESSAGE_MAX_CHARS=32000

# ── 异步 DB 连接池（仅 PostgreSQL；测试用 SQLite 忽略）────────────────
# 池内常驻连接数
DB_POOL_SIZE=10
# 超出 pool_size 后最多再借出的临时连接数
DB_MAX_OVERFLOW=20
# 从池取连接的最长等待秒数
DB_POOL_TIMEOUT=30
# 连接最长复用秒数后回收；0=不按时间回收（仍可依赖 pool_pre_ping）
DB_POOL_RECYCLE=1800

# ── 鉴权（外部 introspect：Bearer token → user_id）────────────────────
# true：跳过外部鉴权，固定使用 AUTH_DEV_USER_ID（仅本地/测试；生产必须 false）
AUTH_DISABLED=true
# AUTH_DISABLED=true 时使用的固定用户 id（配置与会话按此隔离）
AUTH_DEV_USER_ID=dev-user
# 验 token 的完整 URL；AUTH_DISABLED=false 时必填
AUTH_INTROSPECT_URL=
# 调用 introspect 的方法：GET=只带 Authorization；POST=另发 JSON {"token":"..."}
AUTH_INTROSPECT_METHOD=GET
# introspect 响应 JSON 中用户字段名（支持点路径，如 data.user_id）
AUTH_USER_ID_FIELD=user_id
# 调用外部鉴权接口的超时秒数
AUTH_TIMEOUT_SECONDS=5
# 同一 token 解析结果的进程内缓存 TTL（秒），减轻 introspect 压力
AUTH_CACHE_TTL_SECONDS=60
# /health 探活结果短缓存（秒）；0=每次实时探测；仅缓存成功结果
HEALTH_CACHE_TTL_SECONDS=2

# ── 本地开发常用组合（勿用于生产；取消注释并按需覆盖上面同名项）──────
# AUTH_DISABLED=true
# SECRETS_ALLOW_INSECURE_DEV_KEY=true
# API_WORKERS=1
# API_SERVER=uvicorn
# MCP_STDIO_ENABLED=true
# MCP_STDIO_COMMAND_ALLOWLIST=npx,uvx,node,python,python3,echo
