# 模型提供商：openai | anthropic | openai_compatible
MODEL_PROVIDER=openai_compatible
MODEL_NAME=deepseek-chat

OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.deepseek.com/v1

# Anthropic（可选）
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# 工作区与安全
WORKSPACE_DIR=./workspace
# Memory 默认文件（相对项目根）；方法论 Memory 另有版本化物化
MEMORY_FILE=./AGENTS.md
ENABLE_HITL=true
LOG_LEVEL=INFO

# PostgreSQL（方法论 / Agent / Tool 配置库）
DATABASE_URL=postgresql+psycopg://deepagents:deepagents@127.0.0.1:5432/deepagents

# Redis checkpointer（需 Redis 8+ 或 Redis Stack；不可用时直接失败，无内存降级）
# Windows 建议 127.0.0.1：localhost 常解析到 ::1，而 compose 只映射 IPv4
REDIS_URL=redis://127.0.0.1:6379

# 进程内 Agent 编译缓存上限；淘汰时清构建锁（Skills 物化按内容寻址保留）
AGENT_CACHE_MAX_SIZE=32
# 每个方法论保留的历史快照上限（会话仍引用的版本不会删）
METHODOLOGY_REVISION_KEEP=20
# Skills 物化 GC：.complete 超过该天数未刷新则删除；0=禁用
SKILLS_GC_MAX_AGE_DAYS=14
# 残留临时目录超过该小时数则删除
SKILLS_GC_TMP_MAX_AGE_HOURS=1
# API 后台 GC 间隔（小时）；与 content_blob 共用一个 PeriodicTask；0=后台跳过该项
# 手动：python -m deepagents_app.services.infra.gc [skills|blobs|all]
# 全集群间隔，不随 API_WORKERS 放大（同窗口内只有抢到 Redis 锁的 worker 执行）
SKILLS_GC_INTERVAL_HOURS=24
CONTENT_BLOB_GC_INTERVAL_HOURS=24
# 加密模型 api_key：Fernet url-safe base64 密钥，或任意口令（会 SHA256 派生）
# 生产必须设置；可用：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=
# 仅本地：未配置 SECRETS_ENCRYPTION_KEY 时允许固定开发密钥（生产必须 false）
SECRETS_ALLOW_INSECURE_DEV_KEY=false
# 密钥轮转：旧密钥逗号分隔；解密时主密钥失败后依次尝试
# SECRETS_ENCRYPTION_PREVIOUS_KEYS=

# MCP：stdio 会在 API 进程执行命令，默认关闭；本地调试再打开
MCP_STDIO_ENABLED=false
MCP_STDIO_COMMAND_ALLOWLIST=npx,uvx,node,python,python3

# FastAPI
API_HOST=0.0.0.0
API_PORT=8001
# 进程数（>1 启用多 worker；缓存失效走 Redis pub/sub，流式限流默认走 Redis）
API_WORKERS=2
# 启动器：uvicorn | gunicorn（后者用 UvicornWorker；Windows 无 fcntl，会自动回退 uvicorn）
API_SERVER=gunicorn
# CORS 允许的前端源（逗号分隔）；勿使用 *（与 credentials 冲突）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 流式对话并发上限（0=不限）；抢槽超时秒数（0≈立即 429）；单条消息最大字符数
CHAT_STREAM_MAX_CONCURRENT=32
CHAT_STREAM_ACQUIRE_TIMEOUT_SECONDS=1
# 流式限流：auto=多 worker 用 Redis 全局；local / redis 可强制
CHAT_STREAM_LIMITER=auto
CHAT_MESSAGE_MAX_CHARS=32000
# 异步 DB 连接池（仅 PostgreSQL；SQLite 测试忽略）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# 鉴权：外部 API 解析 Bearer token → user_id
# 生产必须 AUTH_DISABLED=false 并配置 AUTH_INTROSPECT_URL
AUTH_DISABLED=true
AUTH_DEV_USER_ID=dev-user
AUTH_INTROSPECT_URL=
# GET：请求头带 Authorization；POST：另发 JSON {"token":"..."}
AUTH_INTROSPECT_METHOD=GET
AUTH_USER_ID_FIELD=user_id
AUTH_TIMEOUT_SECONDS=5
AUTH_CACHE_TTL_SECONDS=60
# /health 探活短缓存（秒）；0=每次实时探测
HEALTH_CACHE_TTL_SECONDS=2

# 本地开发示例（勿用于生产）：
# AUTH_DISABLED=true
# SECRETS_ALLOW_INSECURE_DEV_KEY=true
# MCP_STDIO_ENABLED=true
# MCP_STDIO_COMMAND_ALLOWLIST=npx,uvx,node,python,python3,echo
