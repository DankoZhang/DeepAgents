# 字节码与缓存
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 旧迁移目录名会遮蔽 PyPI alembic 包；正式脚本在 migrations/
/alembic/

# 虚拟环境
.venv/
venv/

# 密钥与本地配置
.env

# 运行时工作区：用户沙箱在 workspace/users/<scope>/
# （documents / notes / audit / skills / memory 等均在其下生成）
/workspace/*
!/workspace/.gitkeep

# 系统杂项
.DS_Store
*.log
